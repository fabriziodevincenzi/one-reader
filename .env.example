# Public origin used for the private Stop and Report links included in letters.
SITE_URL=http://localhost:4321
# Set this server-side value when the public waitlist counter should be shown.
PUBLIC_WAITLIST_COUNT=0
# Supabase browser client configuration. Never put a service-role key here.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
PUBLIC_TURNSTILE_SITE_KEY=0x-your-site-key

# Server-only Edge Function secrets. Configure these with `supabase secrets set`;
# never expose them through a PUBLIC_ variable or commit their real values.
RESEND_API_KEY=re_your-key
RESEND_WEBHOOK_SECRET=whsec_your-secret
WORKER_SECRET=generate-at-least-32-random-bytes
ALIAS_HMAC_SECRET=generate-at-least-32-random-bytes
# Base64 encoding of exactly 32 random bytes, used only to wrap per-letter keys.
LETTER_CONTENT_KEK=base64-encoded-32-byte-key
LETTER_WRITE_ADDRESS=write@onereader.co
LETTER_ALIAS_DOMAIN=reply.onereader.co
SERVICE_FROM_ADDRESS=One Reader <letters@onereader.co>
# Keep transactional messages in the private preview outbox until the real
# sending domain is ready. Change to `resend` only for an intentional live test.
TRANSACTIONAL_EMAIL_MODE=preview
# Keep true in production. Set false only for controlled local webhook fixtures.
REQUIRE_EMAIL_AUTHENTICATION=true

# Stripe server-side configuration. Each Price contains the supported currency
# options. Keep the Live IDs in Supabase secrets, never in client code.
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_WRITER_PRICE_ANNUAL=price_1U91xaBA5ijGzHgS2riHa649
STRIPE_WRITER_PRICE_MONTHLY=price_1U91lyBA5ijGzHgSY5vBt5UV
STRIPE_AUTOMATIC_TAX=false
