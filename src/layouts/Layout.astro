---
import '../styles/global.css';
import type { SiteLocale } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  socialImage?: string;
  socialImageAlt?: string;
  ogType?: 'website' | 'article';
  locale?: SiteLocale | string;
  alternateLocales?: Partial<Record<SiteLocale, string>>;
  referrerPolicy?: 'no-referrer';
  turnstileSiteKey?: string;
  indexable?: boolean;
}

const {
  title = 'One Reader',
  description = 'A private correspondence club where one letter reaches one unknown reader. No profiles, no feed, no judgment.',
  socialImage,
  socialImageAlt,
  ogType = 'website',
  locale = 'en',
  alternateLocales = {},
  referrerPolicy,
  turnstileSiteKey,
  indexable = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index,follow,max-image-preview:large' : 'noindex,follow'} />
    {referrerPolicy && <meta name="referrer" content={referrerPolicy} />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    {Object.entries(alternateLocales).map(([alternateLocale, href]) => (
      <link rel="alternate" hreflang={alternateLocale} href={href} />
    ))}
    {alternateLocales.en && <link rel="alternate" hreflang="x-default" href={alternateLocales.en} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,300;0,400;0,700;1,300&amp;family=IBM+Plex+Serif:ital,wght@0,400;0,500;1,400&amp;display=swap" rel="stylesheet" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="One Reader" />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:width" content="1200" />}
    {socialImage && <meta property="og:image:height" content="630" />}
    {socialImageAlt && <meta property="og:image:alt" content={socialImageAlt} />}
    {socialImage && <meta property="og:image:type" content="image/png" />}
    {socialImage && <meta property="og:image:secure_url" content={socialImage} />}
    {socialImage && <meta name="twitter:card" content="summary_large_image" />}
    {socialImage && <meta name="twitter:title" content={title} />}
    {socialImage && <meta name="twitter:description" content={description} />}
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && <meta name="twitter:image:src" content={socialImage} />}
    {socialImageAlt && <meta name="twitter:image:alt" content={socialImageAlt} />}
    {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}
    <title>{title}</title>
  </head>
  <body>
    <a
      class="sr-only fixed left-3 top-3 z-50 bg-foreground px-4 py-2 text-background focus:not-sr-only"
      href="#main-content"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
