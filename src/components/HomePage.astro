---
import Layout from '../layouts/Layout.astro';
import { Button, buttonVariants } from '../components/ui/Button';
import { Input } from '../components/ui/Input';
import SiteFooter from './SiteFooter.astro';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const steps = [
  {
    icon: 'write',
    title: 'Write a letter',
    body: 'Write to someone you do not know, from the quiet of your own inbox. Let the letter travel.',
  },
  {
    icon: 'match',
    title: 'We find a reader',
    body: 'We choose one person who can read your language. Your address stays private.',
  },
  {
    icon: 'inbox',
    title: 'It arrives by email',
    body: 'Your letter reaches their inbox. There is no public profile, feed, or performance.',
  },
  {
    icon: 'reply',
    title: 'Reply if you want',
    body: 'Answer in your own words, continue the correspondence, or leave room for silence.',
  },
];

---

<Layout title="One Reader" description="A private correspondence club where one letter reaches one unknown reader. No profiles, no feed, no judgment." turnstileSiteKey={turnstileSiteKey}>
  <header class="brand-header border-b border-border">
    <div class="shell flex min-h-20 items-center justify-between gap-6">
      <a class="font-serif text-[1.35rem] tracking-[-0.025em] no-underline" href="/" aria-label="One Reader, home">
        One Reader
      </a>
      <a class={buttonVariants({ variant: 'outline', size: 'small' })} href="/sign-in/">Log in</a>
    </div>
  </header>

  <main id="main-content" class="brand-page brand-home">
    <section class="border-b border-border py-16 sm:py-24 lg:py-32">
      <div class="shell">
        <h1 class="display balance">One letter. One reader. Maybe a reply.</h1>
        <p class="mt-8 max-w-xl text-lg leading-8 text-muted-foreground sm:text-xl">
          Write to someone you do not know, from the quiet of your own inbox. No profiles to perform for. No feed to keep up with.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a class={buttonVariants({ size: 'large' })} href="#start-free">Start free</a>
          <a class={buttonVariants({ variant: 'quiet', size: 'large' })} href="#how-it-works">See how it works</a>
        </div>
      </div>
    </section>

    <section class="border-b border-border py-20 sm:py-28" id="how-it-works">
      <div class="shell">
        <div>
          <div>
            <p class="eyebrow mb-5">How it works</p>
            <h2 class="section-title balance">A small ritual, not another platform.</h2>
          </div>
        </div>

        <div class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-12">
          {steps.map((step) => (
            <article class="px-0 py-2 sm:py-3">
              <div class="mb-7 flex h-11 w-11 items-center justify-center rounded-full border border-accent/50 text-accent" aria-hidden="true">
                {step.icon === 'write' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg>}
                {step.icon === 'match' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="8.5"/><path d="M8.5 12h7M12 8.5v7"/></svg>}
                {step.icon === 'inbox' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 5.5h16v13H4z"/><path d="m4 7 8 6 8-6M4 15h4l1.5 2h5L16 15h4"/></svg>}
                {step.icon === 'reply' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 8 5 12l4 4"/><path d="M5 12h8a6 6 0 0 1 6 6v1"/></svg>}
              </div>
              <h3 class="m-0 font-serif text-2xl font-normal tracking-[-0.025em]">{step.title}</h3>
              <p class="mt-4 m-0 leading-7 text-muted-foreground">{step.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b border-border py-20 sm:py-28" id="start-free">
      <div class="shell">
          <form class="relative overflow-hidden rounded-2xl bg-surface p-7 sm:p-10" data-start-free-form>
            <div data-start-free-fields>
              <h3 class="font-serif text-3xl font-normal leading-tight tracking-[-0.03em] sm:text-4xl">Create your free Reader account</h3>
              <p class="mt-5 max-w-2xl leading-7 text-muted-foreground">Your email stays private from whoever you write to. We’ll use your address to create your account, verify your mailbox and operate the service. Optional Journal messages are separate and can be withdrawn later.</p>
              <div class="mt-8">
                <label class="mb-2 block text-sm font-medium" for="start-free-email">Email address</label>
                <div class="grid gap-3 sm:grid-cols-[1fr_auto]">
                  <Input id="start-free-email" name="email" type="email" autoComplete="email" placeholder="you@example.com" required aria-describedby="start-free-note" className="bg-background" />
                  <div>
                    <Button type="submit" size="large">Sign up</Button>
                  </div>
                </div>
              </div>
              <label class="mt-6 flex items-start gap-3 text-[0.75rem] leading-5">
                <input class="mt-1" type="checkbox" name="termsAccepted" required />
                <span>I agree to the <a class="underline underline-offset-4" href="/terms">Terms of Service</a> and acknowledge the <a class="underline underline-offset-4" href="/privacy">Privacy notice</a>.</span>
              </label>
              <label class="mt-5 flex items-start gap-3 text-[0.75rem] leading-5 text-muted-foreground">
                <input class="mt-1" type="checkbox" name="journalOptIn" value="yes" />
                <span>Send me occasional Journal notes and product news. Optional; unsubscribe anytime.</span>
              </label>
              <input class="absolute -left-[9999px] h-px w-px opacity-0" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
            </div>
            {turnstileSiteKey && (
              <div class="hidden mt-8 rounded-sm bg-background p-5 sm:p-8" data-start-free-captcha-step>
                <div class="min-h-[65px] w-full max-w-full" data-turnstile-widget data-sitekey={turnstileSiteKey} aria-label="Security check"></div>
              </div>
            )}
            <p class="mt-4 hidden text-xs leading-5 text-muted-foreground" id="start-free-note" data-start-free-note></p>
            <div class="hidden" data-start-free-success aria-live="polite">
              <p class="eyebrow mb-5">Check your inbox</p>
              <h3 class="max-w-md font-serif text-3xl font-normal leading-tight tracking-[-0.03em] sm:text-4xl">Your first letter starts here.</h3>
              <p class="mt-5 max-w-md leading-7 text-muted-foreground">We sent a one-time link to verify your address. Follow it to open your Reader account.</p>
              <a class="mt-7 inline-flex text-sm underline underline-offset-4 hover:text-foreground" href="/sign-in/">Already registered? Open your account</a>
            </div>
          </form>
      </div>
    </section>

    <section class="py-20 sm:py-28">
      <div class="shell grid gap-10 md:grid-cols-2 md:gap-20">
        <div>
          <p class="eyebrow mb-5">Already a member?</p>
          <h2 class="section-title">Everything important stays in your inbox.</h2>
        </div>
        <div class="self-end">
          <p class="text-lg leading-8 text-muted-foreground">Your private area is for membership, language details, consents, privacy requests, and account deletion. The correspondence itself remains where it belongs — in your email.</p>
          <a class={buttonVariants({ variant: 'outline', size: 'small' }) + ' mt-6'} href="/sign-in/">Log in to your account</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  type TurnstileApi = {
    render: (container: HTMLElement, options: {
      sitekey: string;
      theme: 'light' | 'dark' | 'auto';
      size: 'normal' | 'compact' | 'flexible';
      appearance: 'always' | 'execute' | 'interaction-only';
      language: string;
      callback: (token: string) => void;
      'expired-callback': () => void;
      'error-callback': () => void;
    }) => string;
    reset: (widgetId?: string) => void;
  };

  const form = document.querySelector<HTMLFormElement>('[data-start-free-form]');
  const note = document.querySelector<HTMLElement>('[data-start-free-note]');
  const fields = document.querySelector<HTMLElement>('[data-start-free-fields]');
  const captchaStep = document.querySelector<HTMLElement>('[data-start-free-captcha-step]');
  const success = document.querySelector<HTMLElement>('[data-start-free-success]');
  const captchaWidget = document.querySelector<HTMLElement>('[data-turnstile-widget]');
  let captchaToken: string | null = null;
  let captchaWidgetId: string | null = null;
  let pendingSignup: FormData | null = null;
  const intentKey = 'dear-someone:signup-intent';
  const lastSignupKey = 'dear-someone:free-signup-last-submitted';

  const showNote = (message: string, error = false) => {
    if (!note) return;
    note.textContent = message;
    note.classList.remove('hidden');
    note.classList.toggle('text-destructive', error);
    note.classList.toggle('text-muted-foreground', !error);
  };

  const renderCaptcha = () => {
    const turnstile = (window as Window & { turnstile?: TurnstileApi }).turnstile;
    const sitekey = captchaWidget?.dataset.sitekey;
    if (!turnstile || !captchaWidget || !sitekey || captchaWidget.dataset.rendered) return;
    captchaWidgetId = turnstile.render(captchaWidget, {
      sitekey,
      theme: 'light',
      size: 'flexible',
      appearance: 'always',
      language: 'en',
      callback: handleCaptchaSuccess,
      'expired-callback': () => { captchaToken = null; },
      'error-callback': () => {
        captchaToken = null;
        showNote('The security check could not be completed. Please try again.', true);
      },
    });
    captchaWidget.dataset.rendered = 'true';
  };

  const revealCaptcha = () => {
    if (!captchaStep) return;
    fields?.classList.add('hidden');
    note?.classList.add('hidden');
    captchaStep.classList.remove('hidden');
    window.setTimeout(renderCaptcha, 0);
  };

  const finishFreeSignup = async (session: { access_token: string; user?: { user_metadata?: Record<string, unknown> } }) => {
    if (!supabase) return;
    const rawIntent = window.localStorage.getItem(intentKey);
    let intent: Record<string, unknown> | null = null;
    if (rawIntent) {
      try { intent = JSON.parse(rawIntent); } catch { window.localStorage.removeItem(intentKey); }
    }
    if (!intent) {
      const metadata = session.user?.user_metadata;
      if (metadata?.plan_intent !== 'free') return;
      intent = {
        source: 'signup',
        plan: 'free',
        countryCode: (navigator.language.split('-')[1] || '').toUpperCase() || null,
        languageCode: navigator.language || 'en',
        journalOptIn: metadata.journal_opt_in === true,
        termsAccepted: metadata.terms_accepted === true,
        privacyAcknowledged: metadata.privacy_acknowledged === true,
      };
    }
    const { error } = await supabase.functions.invoke('complete-signup', {
      body: intent,
      headers: { Authorization: `Bearer ${session.access_token}` },
    });
    if (error) {
      showNote('Your email is verified, but we could not finish setting up the account. Please try again from this page.', true);
      return;
    }
    window.localStorage.removeItem(intentKey);
    window.location.assign('/welcome/');
  };

  supabase?.auth.onAuthStateChange((event, session) => {
    const hasCallbackToken = window.location.hash.includes('access_token');
    if (session && hasCallbackToken && (event === 'SIGNED_IN' || event === 'INITIAL_SESSION')) {
      window.history.replaceState({}, document.title, '/welcome/');
      window.setTimeout(() => void finishFreeSignup(session), 0);
    }
  });

  const sendSignupRequest = async (data: FormData, email: string) => {
    if (!form || !supabase) return;
    const lastSubmittedAt = Number(window.localStorage.getItem(lastSignupKey) || '0');
    if (Date.now() - lastSubmittedAt < 60_000) {
      showNote('A confirmation link was just requested. Please wait a moment before trying again.', true);
      pendingSignup = null;
      return;
    }
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submitButton) submitButton.disabled = true;
    if (!captchaToken) showNote('Sending your confirmation link…');
    window.localStorage.setItem(intentKey, JSON.stringify({
      source: 'signup',
      plan: 'free',
      countryCode: (navigator.language.split('-')[1] || '').toUpperCase() || null,
      languageCode: navigator.language || 'en',
      journalOptIn: data.get('journalOptIn') === 'yes',
      termsAccepted: data.get('termsAccepted') === 'on',
      privacyAcknowledged: data.get('termsAccepted') === 'on',
    }));
    window.localStorage.setItem(lastSignupKey, String(Date.now()));
    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: {
        shouldCreateUser: true,
        emailRedirectTo: `${window.location.origin}/welcome/`,
        captchaToken: captchaToken ?? undefined,
        data: {
          source: 'signup',
          plan_intent: 'free',
          market_country: (navigator.language.split('-')[1] || '').toUpperCase() || null,
          language_code: navigator.language || 'en',
          journal_opt_in: data.get('journalOptIn') === 'yes',
          terms_accepted: data.get('termsAccepted') === 'on',
          privacy_acknowledged: data.get('termsAccepted') === 'on',
        },
      },
    });
    if (submitButton) submitButton.disabled = false;
    if (error) {
      captchaToken = null;
      const turnstile = (window as Window & { turnstile?: TurnstileApi }).turnstile;
      if (turnstile && captchaWidgetId) turnstile.reset(captchaWidgetId);
      window.localStorage.removeItem(intentKey);
      fields?.classList.remove('hidden');
      captchaStep?.classList.add('hidden');
      showNote(error.message || 'We could not send the link. Please try again.', true);
      return;
    }
    captchaStep?.classList.add('hidden');
    fields?.classList.add('hidden');
    success?.classList.remove('hidden');
    pendingSignup = null;
  };

  const handleCaptchaSuccess = (token: string) => {
    captchaToken = token;
    if (pendingSignup) {
      const email = String(pendingSignup.get('email') || '').trim().toLowerCase();
      void sendSignupRequest(pendingSignup, email);
    }
  };

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const email = String(data.get('email') || '').trim().toLowerCase();
    const honeypot = String(data.get('website') || '').trim();
    if (!email || !supabase) {
      showNote('The free signup is not connected right now. Please try again shortly.', true);
      return;
    }
    if (honeypot) return;
    if (captchaWidget && !captchaToken) {
      pendingSignup = data;
      revealCaptcha();
      return;
    }
    void sendSignupRequest(data, email);
  });
</script>
