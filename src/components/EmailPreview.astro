---
interface Props {
  variant?: 'compose' | 'received';
}

const { variant = 'compose' } = Astro.props;
const isReceived = variant === 'received';
---

<article class="mail-preview overflow-hidden border border-border bg-surface shadow-[0_18px_45px_-36px_rgba(26,26,24,0.4)]" aria-label={isReceived ? 'Example of receiving a private letter' : 'Example of writing a letter from your inbox'}>
  <div class="flex items-center justify-between border-b border-border bg-background/55 px-4 py-3 sm:px-5">
    <div class="flex items-center gap-3" aria-hidden="true">
      <span class="flex gap-1.5"><span class="h-2 w-2 rounded-full bg-border"></span><span class="h-2 w-2 rounded-full bg-border"></span><span class="h-2 w-2 rounded-full bg-border"></span></span>
      <span class="h-4 border-l border-border"></span>
      <span class="metadata">{isReceived ? 'Inbox' : 'Compose'}</span>
    </div>
    {isReceived && <div class="metadata flex items-center gap-2"><span>1 unread</span><span class="h-2 w-2 rounded-full bg-accent" aria-label="Unread"></span></div>}
  </div>

  {isReceived ? (
    <div class="px-4 py-5 sm:px-7 sm:py-6">
      <div class="grid grid-cols-[2.25rem_1fr] gap-3"><div class="flex h-9 w-9 items-center justify-center rounded-full border border-border bg-background text-sm text-muted-foreground">S</div><div class="min-w-0"><div class="flex items-start justify-between gap-3"><div class="min-w-0"><p class="truncate text-[0.78rem] font-semibold leading-5 text-foreground">stranger·4f92@letters.onereader.co</p><p class="text-[0.7rem] leading-4 text-muted-foreground">to you · private alias</p></div><time class="metadata shrink-0 pt-0.5" datetime="2026-08-09T09:14:00+02:00">Today, 9:14</time></div></div></div>
      <div class="ml-[3rem] mt-5 border-t border-border pt-5"><p class="m-0 font-serif text-xl italic leading-8 text-foreground/85">Dear someone,<br />This morning the rain stopped just before I left home. For a few minutes, every window on my street held the same pale light…</p></div>
      <p class="ml-[3rem] mt-7 flex items-center gap-2 border-t border-border pt-4 text-[0.7rem] leading-5 text-muted-foreground">Your address stays private. Reply from your inbox.</p>
    </div>
  ) : (
    <div class="px-4 py-5 sm:px-7 sm:py-6">
      <div class="flex items-center justify-between border-b border-border pb-4"><div><p class="eyebrow mb-1 text-accent">Write a letter</p><p class="metadata m-0">Plain text · private by design</p></div><span class="metadata border border-border px-2 py-1">Draft</span></div>
      <div class="mt-5 grid gap-3 text-[0.72rem]"><div class="flex gap-3 border-b border-border pb-3"><span class="text-muted-foreground">To:</span><span class="font-medium">write@onereader.co</span></div><p class="eyebrow pt-3 text-accent">Write</p><p class="m-0 font-serif text-xl italic leading-8 text-foreground/85">Dear someone,</p><p class="m-0 max-w-md font-serif text-xl italic leading-8 text-foreground/85">Today I noticed how a small pause can change the shape of a whole morning…</p></div>
      <div class="mt-7 flex items-center justify-between border-t border-border pt-4 text-[0.7rem] text-muted-foreground"><span class="max-w-[15rem] leading-5">Your address stays private. They’ll never see your real address either.</span><span class="border border-accent bg-accent px-4 py-2 text-primary-foreground">Send</span></div>
    </div>
  )}
</article>
