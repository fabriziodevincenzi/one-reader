---
import { buttonVariants } from './ui/Button';
import type { SiteLocale } from '../lib/i18n';
import { journalUiCopy } from '../lib/journal-ui';

interface Props {
  action?: 'login' | 'write';
  showPricing?: boolean;
  locale?: SiteLocale;
}

const { action = 'login', showPricing = false, locale = 'en' } = Astro.props;
const copy = journalUiCopy[locale];
---
<header class="brand-header border-b border-border">
  <div class="shell flex min-h-20 items-center justify-between gap-6">
    <a class="brand-logo no-underline" href="/" aria-label={copy.homeLabel}>One Reader</a>
    <div class="flex items-center gap-5">
      {showPricing && <a class="hidden text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline sm:inline" href="/pricing/">Pricing</a>}
      {action === 'write' ? (
        <>
          <a class={buttonVariants({ variant: 'outline', size: 'small' })} href="mailto:write@onereader.co" aria-describedby="write-cta-help">{copy.writeToSomeone}</a>
          <span id="write-cta-help" class="sr-only">{copy.writeHelp}</span>
        </>
      ) : (
        <a class={buttonVariants({ variant: 'outline', size: 'small' })} href="/sign-in/">Log in</a>
      )}
    </div>
  </div>
</header>
