---
import type { SiteLocale } from '../lib/i18n';
import { journalUiCopy } from '../lib/journal-ui';

interface Props { locale?: SiteLocale; }
const { locale = 'en' } = Astro.props;
const copy = journalUiCopy[locale];
---
<footer class="border-t border-border py-8">
  <div class="shell flex flex-col gap-5 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
    <p class="m-0">© 2026 One Reader</p>
    <nav class="flex gap-5" aria-label={copy.footerLabel}>
      <a class="underline-offset-4 hover:text-foreground hover:underline" href="/about/">{copy.about}</a>
      <a class="underline-offset-4 hover:text-foreground hover:underline" href="/journal/">Journal</a>
      <a class="underline-offset-4 hover:text-foreground hover:underline" href="/privacy">{copy.privacy}</a>
      <a class="underline-offset-4 hover:text-foreground hover:underline" href="/terms">{copy.terms}</a>
    </nav>
  </div>
</footer>
