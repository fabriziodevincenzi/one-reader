---
import Layout from '../../layouts/Layout.astro';
import { buttonVariants } from '../../components/ui/Button';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---

<Layout title="Welcome to One Reader" description="A private pen-pal correspondence with one real reader, no profile, no audience and no past to perform for." indexable={false}>
  <SiteHeader />

  <main id="main-content" class="shell brand-page py-16 sm:py-24">
    <article class="mx-auto max-w-3xl">
      <header class="border-b border-border pb-14 sm:pb-20">
        <p class="eyebrow mb-5">Welcome to One Reader</p>
        <h1 class="section-title max-w-3xl balance">Write to one person. Be unknown again.</h1>
        <p class="brand-prose mt-8 max-w-2xl text-xl leading-9 text-muted-foreground sm:text-2xl sm:leading-10">One Reader is a place to find a pen pal by writing letters to strangers by email. Not to yourself, and not to a crowd—just to one real reader.</p>
      </header>

      <div class="brand-prose space-y-16 py-14 text-lg leading-8 text-muted-foreground sm:space-y-20 sm:py-20">
        <section aria-labelledby="why-heading">
          <p class="eyebrow mb-4">Why it exists</p>
          <h2 id="why-heading" class="max-w-2xl text-3xl font-normal leading-tight tracking-[-0.005em] text-foreground sm:text-4xl">Some things need a reader—but not an audience.</h2>
          <div class="mt-6 max-w-2xl space-y-5">
            <p>A diary has only one reader: you. A social network has too many, and your face or familiar name stays attached to every word. Both can make it hard to say what you actually mean.</p>
            <p>One Reader sits in between. Someone real is there to read you, but no one knows you, no history follows you and no future needs protecting. That freedom is the point—before any reply arrives.</p>
          </div>
        </section>

        <section class="border-y border-border py-10 sm:py-12" aria-labelledby="how-heading">
          <p class="eyebrow mb-4">How it works</p>
          <h2 id="how-heading" class="text-3xl font-normal leading-tight tracking-[-0.005em] text-foreground sm:text-4xl">Every correspondence starts clean.</h2>
          <ol class="mt-10 grid gap-8 sm:gap-10">
            <li class="grid gap-3 sm:grid-cols-[5.5rem_1fr] sm:gap-6">
              <span class="metadata pt-1">01 / Write</span>
              <p class="m-0">Send your letter to <a class="text-foreground underline underline-offset-4" href="mailto:write@onereader.co">write@onereader.co</a>. We find one available person who can read the language you chose.</p>
            </li>
            <li class="grid gap-3 sm:grid-cols-[5.5rem_1fr] sm:gap-6">
              <span class="metadata pt-1">02 / Be unknown</span>
              <p class="m-0">Each conversation uses a new name and a private reply address. The person who knows you from one letter cannot trace you into another. Your real email address stays private.</p>
            </li>
            <li class="grid gap-3 sm:grid-cols-[5.5rem_1fr] sm:gap-6">
              <span class="metadata pt-1">03 / Continue, or let go</span>
              <p class="m-0">If they reply, a correspondence begins: letter, reply, letter, reply. It closes permanently after 30 days without a reply, or sooner if either person chooses <em>End this conversation</em> in the email.</p>
            </li>
          </ol>
        </section>

        <section aria-labelledby="plans-heading">
          <p class="eyebrow mb-4">Two ways to belong</p>
          <h2 id="plans-heading" class="text-3xl font-normal leading-tight tracking-[-0.005em] text-foreground sm:text-4xl">Reading and replying are always open.</h2>
          <div class="mt-10 grid gap-px overflow-hidden border border-border bg-border sm:grid-cols-2">
            <section class="bg-background p-7 sm:p-8" aria-labelledby="reader-heading">
              <p class="metadata mb-5">Free</p>
              <h3 id="reader-heading" class="text-3xl font-normal tracking-[-0.005em] text-foreground">Reader</h3>
              <p class="mt-5 text-base leading-7">Receive letters and reply to every conversation that reaches you. You can also write first once—whenever it feels right.</p>
            </section>
            <section class="writer-card p-7 sm:p-8" aria-labelledby="writer-heading">
              <p class="metadata mb-5">Paid · monthly or annually</p>
              <h3 id="writer-heading" class="text-3xl font-normal tracking-[-0.005em] text-foreground">Writer</h3>
              <p class="mt-5 text-base leading-7">Write first again and again: one new letter every 24 hours. <span data-membership-price>€18 a year or €2 a month</span>.</p>
            </section>
          </div>
          <p class="mt-6 max-w-2xl text-base leading-7">Writing first is different from replying: you choose when to begin, who might receive it, and what to say without being prompted. That is the small, essential act Writer makes possible again.</p>
        </section>

        <section class="max-w-2xl" aria-labelledby="before-heading">
          <p class="eyebrow mb-4">Before your first letter</p>
          <h2 id="before-heading" class="text-3xl font-normal leading-tight tracking-[-0.005em] text-foreground">Keep the room kind and safe.</h2>
          <ul class="mt-6 grid gap-4 text-base leading-7">
            <li><strong class="font-medium text-foreground">A reply is never owed.</strong> Write when you have something to say, and give the other person the same freedom.</li>
            <li><strong class="font-medium text-foreground">Keep personal details personal.</strong> Do not share passwords, financial details, exact addresses, or requests for someone else's private information.</li>
            <li><strong class="font-medium text-foreground">Use the email links if you need them.</strong> You can end or report a correspondence without replying.</li>
          </ul>
        </section>
      </div>

      <footer class="flex flex-wrap items-center gap-5 border-t border-border pt-8">
        <a class={buttonVariants({ size: 'large' })} href="/member/">Set up my account</a>
        <a class="text-sm text-muted-foreground underline underline-offset-4 hover:text-foreground" href="/terms">Read the full terms</a>
      </footer>
    </article>
  </main>
  <SiteFooter />

  <script>
    import { supabase } from '../../lib/supabase';
    import { marketForCountry } from '../../lib/market-pricing';
    import { priceGrid } from '../../lib/product-config';

    const intentKey = 'dear-someone:signup-intent';
    const priceCopy = document.querySelector<HTMLElement>('[data-membership-price]');
    const countryCode = (navigator.language.split('-')[1] || '').toUpperCase() || undefined;
    const market = marketForCountry(countryCode);
    const formatter = new Intl.NumberFormat(navigator.language || 'en', { style: 'currency', currency: market.currency, maximumFractionDigits: market.currency === 'AUD' ? 2 : 0 });
    const monthlyFormatter = new Intl.NumberFormat(navigator.language || 'en', { style: 'currency', currency: market.currency, minimumFractionDigits: 0, maximumFractionDigits: 2 });
    const annual = formatter.format(market.amount);
    const monthly = monthlyFormatter.format(priceGrid[market.currency].monthly);
    if (priceCopy) priceCopy.textContent = `${annual} a year or ${monthly} a month`;
    const sessionResult = supabase ? await supabase.auth.getSession() : { data: { session: null } };
    const session = sessionResult.data.session;
    if (!session) {
      window.location.assign('/sign-in/');
    } else {
      const rawIntent = window.localStorage.getItem(intentKey);
      if (supabase) {
        try {
          const metadata = session.user.user_metadata ?? {};
          const intent = rawIntent
            ? JSON.parse(rawIntent)
            : metadata.plan_intent === 'free'
              ? {
                  source: 'signup',
                  plan: 'free',
                  countryCode: (navigator.language.split('-')[1] || '').toUpperCase() || null,
                  languageCode: navigator.language || 'en',
                  journalOptIn: metadata.journal_opt_in === true,
                  termsAccepted: metadata.terms_accepted === true,
                  privacyAcknowledged: metadata.privacy_acknowledged === true,
                }
              : null;
          if (intent) {
            const { error } = await supabase.functions.invoke('complete-signup', {
              body: intent,
              headers: { Authorization: `Bearer ${session.access_token}` },
            });
            if (!error) window.localStorage.removeItem(intentKey);
          }
        } catch {
          // The account can still be completed from the account page.
        }
      }
    }
  </script>
</Layout>
