---
import Layout from '../../layouts/Layout.astro';
import { buttonVariants } from '../../components/ui/Button';
import SiteFooter from '../../components/SiteFooter.astro';
import { languageOptions as languages } from '../../lib/i18n';

const birthMonths = [
  [1, 'January'],
  [2, 'February'],
  [3, 'March'],
  [4, 'April'],
  [5, 'May'],
  [6, 'June'],
  [7, 'July'],
  [8, 'August'],
  [9, 'September'],
  [10, 'October'],
  [11, 'November'],
  [12, 'December'],
];

const currentYear = new Date().getUTCFullYear();
---

<Layout title="Your account — One Reader" description="Manage your One Reader membership, practical details, consents and privacy choices." indexable={false}>
  <header class="border-b border-border">
    <div class="shell flex min-h-20 items-center justify-between gap-6">
      <a class="font-serif text-[1.35rem] tracking-[-0.025em] no-underline" href="/" aria-label="One Reader, home">One Reader</a>
      <div class="flex items-center gap-4 text-sm">
        <p class="max-w-[12rem] truncate text-muted-foreground"><span class="account-inline-skeleton" data-account-email-loading aria-label="Loading account"></span><span class="hidden" data-account-email></span></p>
        <button class="text-muted-foreground underline-offset-4 hover:text-foreground hover:underline" type="button" data-sign-out>Log out</button>
      </div>
    </div>
  </header>

  <main id="main-content" class="account-page shell py-12 sm:py-16" data-account-main>
    <section id="account" class="flex flex-col justify-between gap-8 border-b border-border pb-10 sm:flex-row sm:items-end">
      <div>
        <p class="eyebrow mb-5">Account</p>
        <h1 class="section-title balance max-w-3xl">Everything practical, in one place.</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-muted-foreground">Your letters stay in your inbox. This is the small account space for your pace, preferences, consents, payments and privacy.</p>
      </div>
      <div class="account-action-slot">
        <div class="account-action-skeleton" data-account-action-loading aria-hidden="true"></div>
        <a class={buttonVariants({ size: 'large' }) + ' pointer-events-none opacity-0'} href="mailto:write@onereader.co?subject=One%20Reader" data-write-letter>Write to someone</a>
      </div>
    </section>

    <section id="membership" class="grid gap-8 border-b border-border py-10 md:grid-cols-[0.7fr_1.3fr] md:gap-16" aria-labelledby="membership-heading">
      <div>
        <p class="eyebrow mb-4">Your access</p>
        <h2 id="membership-heading" class="font-serif text-3xl font-normal tracking-[-0.03em]">Your plan</h2>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">Reader is free: receive letters, reply freely, and write first once. Writer lets you start one new correspondence every 24 hours, monthly or annually. Receiving letters and replying stay open to everyone.</p>
      </div>
      <div class="relative" data-membership-panel aria-busy="true">
        <div class="account-membership-skeleton" data-membership-skeleton role="status" aria-label="Loading your plan">
          <div class="account-skeleton-art" aria-hidden="true"><span></span><i></i></div>
          <div class="account-skeleton-lines" aria-hidden="true"><span></span><span></span><span></span></div>
        </div>
        <div class="hidden" data-membership-content>
          <div class="border-b border-border pb-6">
          <p class="m-0 font-serif text-3xl tracking-[-0.04em]" data-membership-label>Reader</p>
          <p class="mt-3 max-w-xl text-lg leading-8 text-muted-foreground" data-membership-copy>One first opening is included. You can always receive letters from strangers and reply to conversations already open.</p>
          <p class="mt-4 text-sm leading-6" data-membership-pace>You still have your free first opening.</p>
          <p class="mt-3 hidden text-sm leading-6 text-muted-foreground" data-membership-period></p>
        </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-3 pt-6" data-membership-actions>
          <a class={buttonVariants({ size: 'small' })} href="#checkout" data-membership-primary>Become a Writer</a>
          <a class="hidden border-b border-border px-1 pb-1 text-sm underline-offset-4 hover:border-foreground" href="#refund-request" data-membership-refund>Request a refund</a>
          <p class="mt-1 basis-full max-w-xl text-sm leading-6 text-muted-foreground" data-membership-note>Writer opens one new correspondence every 24 hours. The price is shown in your local currency at checkout.</p>
          <form id="refund-request" class="mt-6 hidden max-w-xl border-t border-border pt-6" data-refund-form>
            <p class="account-interface m-0 text-sm font-medium">Refund request</p>
            <p class="mt-2 text-sm leading-6 text-muted-foreground" data-refund-policy>Choose the reason and tell us what happened. Submitting it does not issue an automatic refund.</p>
            <label class="mt-4 grid gap-2 text-sm"><span>Request type</span><select class="select-control min-h-11 rounded-[var(--radius-control)] border border-input bg-transparent pl-3 text-sm" required data-refund-type><option value="withdrawal_14_day">Right of withdrawal (within 14 days)</option><option value="service_issue">Problem with the service</option><option value="goodwill">Other request</option></select></label>
            <label class="mt-4 grid gap-2 text-sm"><span>Details</span><textarea class="min-h-28 rounded-[var(--radius-control)] border border-input bg-transparent p-3 text-sm" required minlength="10" maxlength="2000" data-refund-reason></textarea></label>
            <div class="mt-4 flex flex-wrap items-center gap-4"><button class={buttonVariants({ size: 'small' })} type="submit">Send request</button><button class="text-sm underline underline-offset-4" type="button" data-refund-cancel>Cancel</button></div>
            <p class="mt-4 hidden text-sm leading-6" data-refund-note></p>
          </form>
          </div>
        </div>
      </div>
    </section>

    <section id="profile" class="grid gap-8 border-b border-border py-10 md:grid-cols-[0.7fr_1.3fr] md:gap-16" aria-labelledby="profile-heading">
      <div>
        <p class="eyebrow mb-4">Practical details</p>
        <h2 id="profile-heading" class="font-serif text-3xl font-normal tracking-[-0.03em]">Delivery details</h2>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">Your email stays private. Your age group and languages help us make a suitable match.</p>
      </div>
      <form class="grid max-w-2xl gap-5" data-profile-form>
        <div class="grid gap-2">
          <p class="account-interface m-0 text-sm font-medium">Email address</p>
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
            <p class="m-0 text-sm text-muted-foreground"><span class="account-inline-skeleton account-inline-skeleton-wide" data-profile-email-loading aria-label="Loading email address"></span><span class="hidden" data-profile-email></span></p>
            <a class="text-xs underline underline-offset-4" href="/sign-in/?mode=change-email">Change email</a>
          </div>
        </div>

        <fieldset class="border-0 border-t border-border p-0 pt-5" data-birth-details>
          <legend class="sr-only">Month and year of birth</legend>
          <div class="grid gap-4">
            <p class="account-interface m-0 text-sm font-medium">Month and year of birth</p>
            <div class="grid gap-3 sm:grid-cols-2">
              <label class="grid gap-2 text-xs">
                <span class="text-muted-foreground">Month</span>
                <select class="select-control min-h-11 rounded-[var(--radius-control)] border border-input bg-transparent pl-3 text-sm disabled:opacity-60" name="birthMonth" required data-birth-month>
                  <option value="">Choose month</option>
                  {birthMonths.map(([value, label]) => <option value={value}>{label}</option>)}
                </select>
              </label>
              <label class="grid gap-2 text-xs">
                <span class="text-muted-foreground">Year</span>
                <input class="min-h-11 rounded-[var(--radius-control)] border border-input bg-transparent px-3 text-sm disabled:opacity-60" type="number" name="birthYear" min={currentYear - 120} max={currentYear - 14} inputmode="numeric" placeholder={String(currentYear - 18)} required data-birth-year />
              </label>
            </div>
            <p class="m-0 text-xs leading-5 text-muted-foreground">Month and year only. Used to keep age groups separate.</p>
          </div>
        </fieldset>

        <fieldset class="border-0 border-t border-border p-0 pt-5">
          <legend class="sr-only">Languages for letters</legend>
          <div class="grid gap-4">
            <p class="account-interface m-0 text-sm font-medium">Languages for letters</p>
            <div class="grid gap-3" data-language-list></div>
            <template data-language-template>
              <div class="grid gap-3 sm:grid-cols-[minmax(0,28rem)_auto] sm:items-center" data-language-row>
                <label class="text-sm">
                  <span class="sr-only">Language</span>
                  <select class="select-control min-h-11 w-full rounded-[var(--radius-control)] border border-input bg-transparent pl-3" data-language-select>
                    {languages.map(([value, label]) => <option value={value}>{label}</option>)}
                  </select>
                </label>
                <button class="w-fit border-b border-border pb-1 text-sm text-muted-foreground hover:border-foreground hover:text-foreground" type="button" data-remove-language>Remove</button>
              </div>
            </template>
            <button class="w-fit border-b border-foreground pb-1 text-sm" type="button" data-add-language>Add another language</button>
          </div>
        </fieldset>

        <div class="flex flex-wrap items-center gap-4 border-t border-border pt-5">
          <button class={buttonVariants({ variant: 'outline', size: 'small' })} type="submit">Save details</button>
          <p class="hidden text-sm text-accent" data-profile-note></p>
        </div>
      </form>
    </section>

    <section id="messages" class="grid gap-8 border-b border-border py-10 md:grid-cols-[0.7fr_1.3fr] md:gap-16" aria-labelledby="messages-heading">
      <div>
        <p class="eyebrow mb-4">Your choices</p>
        <h2 id="messages-heading" class="font-serif text-3xl font-normal tracking-[-0.03em]">Messages and consents</h2>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">The service messages you need come first. Optional Journal notes remain your choice.</p>
      </div>
      <form class="grid gap-5 text-sm leading-6" data-consent-form>
        <div class="border-b border-border pb-5">
          <p class="m-0"><strong class="font-medium">Service emails</strong></p>
          <p class="mt-1 m-0 text-muted-foreground">Magic links, delivery notices, account security and subscription messages are necessary to provide the service. They are not marketing consent and cannot be switched off while your account is open.</p>
        </div>
        <label class="flex items-start gap-3">
          <input class="mt-1" type="checkbox" name="journalOptIn" />
          <span><strong class="font-medium">Journal and product notes</strong><br /><span class="text-muted-foreground">Occasional notes about One Reader. Optional and revocable at any time.</span></span>
        </label>
        <div class="flex flex-wrap items-center gap-4">
          <button class={buttonVariants({ variant: 'outline', size: 'small' })} type="submit">Save communication choices</button>
          <p class="hidden text-sm text-accent" data-consent-note></p>
        </div>
      </form>
    </section>

    <section id="letters" class="grid gap-8 border-b border-border py-10 md:grid-cols-[0.7fr_1.3fr] md:gap-16" aria-labelledby="letters-heading">
      <div>
        <p class="eyebrow mb-4">Email-first by design</p>
        <h2 id="letters-heading" class="font-serif text-3xl font-normal tracking-[-0.03em]">Your letters stay in your inbox.</h2>
      </div>
      <div class="max-w-2xl">
        <div class="divide-y divide-border border-y border-border">
          <div class="flex items-baseline justify-between gap-6 py-4">
            <p class="account-interface m-0 text-sm font-medium">Correspondences started</p>
            <p class="m-0 font-mono text-xs uppercase tracking-[0.12em]"><span data-stat-started>0</span> total</p>
          </div>
          <div class="flex items-baseline justify-between gap-6 py-4">
            <p class="account-interface m-0 text-sm font-medium">Open now</p>
            <p class="m-0 font-mono text-xs uppercase tracking-[0.12em]"><span data-stat-open>0</span> active</p>
          </div>
          <div class="flex items-baseline justify-between gap-6 py-4">
            <p class="account-interface m-0 text-sm font-medium">Last letter</p>
            <p class="m-0 text-right font-mono text-xs uppercase tracking-[0.12em]" data-stat-last>None yet</p>
          </div>
        </div>
        <p class="mt-5 max-w-xl text-sm leading-6 text-muted-foreground">Letters remain in the email account you already use. You can stop a conversation from its first letter whenever you want.</p>
      </div>
    </section>

    <section id="privacy" class="grid gap-8 border-b border-border py-10 md:grid-cols-[0.7fr_1.3fr] md:gap-16" aria-labelledby="privacy-heading">
      <div>
        <p class="eyebrow mb-4">Control</p>
        <h2 id="privacy-heading" class="font-serif text-3xl font-normal tracking-[-0.03em]">Privacy</h2>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">You don't need to email support to exercise your rights — use the buttons below to request your data or read how it's handled.</p>
      </div>
      <div class="max-w-2xl divide-y divide-border border-y border-border">
        <div class="grid gap-4 py-5 sm:grid-cols-[1fr_auto] sm:items-center">
          <div>
            <p class="account-interface m-0 text-sm font-medium">Your personal data</p>
            <p class="mb-0 mt-1 text-xs leading-5 text-muted-foreground">Receive a copy of the information connected to your account.</p>
          </div>
          <button class={buttonVariants({ variant: 'outline', size: 'small' }) + ' w-full sm:w-44'} type="button" data-privacy-request="access">Request data</button>
        </div>
        <div class="grid gap-4 py-5 sm:grid-cols-[1fr_auto] sm:items-center">
          <div>
            <p class="account-interface m-0 text-sm font-medium">Birth details</p>
            <p class="mb-0 mt-1 text-xs leading-5 text-muted-foreground">Ask us to correct the saved month or year if either is inaccurate.</p>
          </div>
          <button class={buttonVariants({ variant: 'outline', size: 'small' }) + ' w-full sm:w-44'} type="button" data-privacy-request="rectification">Request correction</button>
        </div>
        <div class="grid gap-4 py-5 sm:grid-cols-[1fr_auto] sm:items-center">
          <div>
            <p class="account-interface m-0 text-sm font-medium">Privacy notice</p>
            <p class="mb-0 mt-1 text-xs leading-5 text-muted-foreground">See how One Reader uses, stores and removes personal data.</p>
          </div>
          <a class={buttonVariants({ variant: 'outline', size: 'small' }) + ' w-full sm:w-44'} href="/privacy">Read the notice</a>
        </div>
        <p class="hidden py-4 text-sm leading-6 text-accent" data-privacy-note></p>
      </div>
    </section>

    <section id="close-account" class="grid gap-8 border-b border-border py-10 md:grid-cols-[0.7fr_1.3fr] md:gap-16" aria-labelledby="close-heading">
      <div>
        <p class="eyebrow mb-4">Permanent action</p>
        <h2 id="close-heading" class="font-serif text-3xl font-normal tracking-[-0.03em]">Close your account</h2>
      </div>
      <form data-delete-account>
        <p class="m-0 max-w-xl text-sm leading-6 text-muted-foreground">Your service access and incoming deliveries stop immediately. We retain only the minimum records needed for up to 30 days to handle the request or a related dispute, then remove them unless a longer legal obligation applies.</p>
        <button class={buttonVariants({ variant: 'outline', size: 'small' }) + ' mt-5 border-accent text-accent hover:border-accent hover:bg-transparent'} type="submit">Request account deletion</button>
        <p class="mt-4 hidden text-sm leading-6 text-accent" data-delete-note></p>
      </form>
    </section>

  </main>

  <SiteFooter />

  <style>
    .account-inline-skeleton,
    .account-action-skeleton,
    .account-membership-skeleton {
      overflow: hidden;
      background: linear-gradient(105deg, #e5ddd0 18%, #f6f1e8 42%, #e5ddd0 66%);
      background-size: 240% 100%;
      animation: account-shimmer 2.8s ease-in-out infinite;
    }

    .account-inline-skeleton {
      display: inline-block;
      width: 9.5rem;
      height: 0.85rem;
      border-radius: 999px;
      vertical-align: middle;
    }

    .account-inline-skeleton-wide {
      width: 13.25rem;
    }

    .account-action-skeleton {
      min-height: 3.85rem;
      border-radius: var(--radius-control);
    }

    .account-action-slot {
      position: relative;
      width: min(100%, 22.5rem);
      min-height: 3.85rem;
    }

    .account-action-slot > * {
      position: absolute;
      inset: 0;
      width: 100%;
    }

    .account-action-slot > a {
      display: inline-flex;
      justify-content: center;
    }

    .account-membership-skeleton {
      display: grid;
      min-height: 16.5rem;
      grid-template-columns: 8.5rem minmax(0, 1fr);
      gap: 2rem;
      align-items: center;
      padding: 1.5rem;
      border: 1px solid var(--border);
      background-color: var(--surface);
    }

    .account-skeleton-art {
      position: relative;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      border: 1px solid color-mix(in srgb, var(--border) 85%, transparent);
      background: #d9ccbc;
    }

    .account-skeleton-art::before,
    .account-skeleton-art::after,
    .account-skeleton-art span,
    .account-skeleton-art i {
      position: absolute;
      display: block;
      content: '';
    }

    .account-skeleton-art::before {
      width: 7.5rem;
      height: 7.5rem;
      border-radius: 50%;
      top: -2.4rem;
      right: -2.2rem;
      background: #f4e8d3;
      box-shadow: 0 0 3rem 1rem rgba(255, 249, 237, 0.62);
      animation: account-light 3.6s ease-in-out infinite;
    }

    .account-skeleton-art::after {
      inset: auto -2.2rem -3.1rem 1.8rem;
      height: 8rem;
      border-radius: 50% 50% 0 0;
      background: #a96b53;
      opacity: 0.74;
    }

    .account-skeleton-art span {
      z-index: 1;
      width: 5.15rem;
      height: 3.6rem;
      top: 45%;
      left: 16%;
      border: 1px solid rgba(88, 64, 51, 0.22);
      background: #f8f2e7;
      box-shadow: 0 0.55rem 1.1rem rgba(87, 60, 43, 0.13);
      transform: rotate(-7deg);
    }

    .account-skeleton-art i {
      z-index: 2;
      width: 3.7rem;
      height: 1px;
      top: 58%;
      left: 29%;
      background: #bba998;
      box-shadow: 0 0.5rem 0 #bba998, 0 1rem 0 #bba998;
      transform: rotate(-7deg);
    }

    .account-skeleton-lines {
      display: grid;
      gap: 0.8rem;
    }

    .account-skeleton-lines span {
      display: block;
      height: 0.78rem;
      border-radius: 999px;
      background: color-mix(in srgb, var(--muted-foreground) 15%, transparent);
    }

    .account-skeleton-lines span:nth-child(1) { width: 38%; height: 2rem; }
    .account-skeleton-lines span:nth-child(2) { width: 92%; }
    .account-skeleton-lines span:nth-child(3) { width: 66%; }

    .account-inline-skeleton.account-loader-hidden,
    .account-action-skeleton.account-loader-hidden,
    .account-membership-skeleton.account-loader-hidden {
      display: none;
    }

    @keyframes account-shimmer {
      0%, 100% { background-position: 100% 50%; }
      50% { background-position: 0% 50%; }
    }

    @keyframes account-light {
      0%, 100% { opacity: 0.52; transform: scale(0.88); }
      50% { opacity: 1; transform: scale(1.08); }
    }

    @media (max-width: 40rem) {
      .account-membership-skeleton { grid-template-columns: 5.6rem minmax(0, 1fr); gap: 1.25rem; padding: 1.1rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      .account-inline-skeleton,
      .account-action-skeleton,
      .account-membership-skeleton,
      .account-skeleton-art::before { animation: none; }
    }
  </style>

  <script>
    import { supabase } from '../../lib/supabase';
    import { fallbackMarket, formatAnnualPrice, marketForCountry } from '../../lib/market-pricing';

    const accountEmail = document.querySelector<HTMLElement>('[data-account-email]');
    const profileEmail = document.querySelector<HTMLElement>('[data-profile-email]');
    const membershipLabel = document.querySelector<HTMLElement>('[data-membership-label]');
    const membershipCopy = document.querySelector<HTMLElement>('[data-membership-copy]');
    const membershipPace = document.querySelector<HTMLElement>('[data-membership-pace]');
    const membershipPeriod = document.querySelector<HTMLElement>('[data-membership-period]');
    const membershipPrimary = document.querySelector<HTMLAnchorElement>('[data-membership-primary]');
    const membershipRefund = document.querySelector<HTMLAnchorElement>('[data-membership-refund]');
    const refundForm = document.querySelector<HTMLFormElement>('[data-refund-form]');
    const refundType = document.querySelector<HTMLSelectElement>('[data-refund-type]');
    const refundReason = document.querySelector<HTMLTextAreaElement>('[data-refund-reason]');
    const refundCancel = document.querySelector<HTMLButtonElement>('[data-refund-cancel]');
    const refundNote = document.querySelector<HTMLElement>('[data-refund-note]');
    const refundPolicy = document.querySelector<HTMLElement>('[data-refund-policy]');
    const membershipNote = document.querySelector<HTMLElement>('[data-membership-note]');
    const profileForm = document.querySelector<HTMLFormElement>('[data-profile-form]');
    const profileNote = document.querySelector<HTMLElement>('[data-profile-note]');
    const consentForm = document.querySelector<HTMLFormElement>('[data-consent-form]');
    const consentNote = document.querySelector<HTMLElement>('[data-consent-note]');
    const privacyNote = document.querySelector<HTMLElement>('[data-privacy-note]');
    const deleteForm = document.querySelector<HTMLFormElement>('[data-delete-account]');
    const deleteButton = deleteForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
    const deleteNote = document.querySelector<HTMLElement>('[data-delete-note]');
    const languageList = document.querySelector<HTMLElement>('[data-language-list]');
    const languageTemplate = document.querySelector<HTMLTemplateElement>('[data-language-template]');
    const addLanguageButton = document.querySelector<HTMLButtonElement>('[data-add-language]');
    const birthMonthInput = document.querySelector<HTMLSelectElement>('[data-birth-month]');
    const birthYearInput = document.querySelector<HTMLInputElement>('[data-birth-year]');
    const journalCheckbox = document.querySelector<HTMLInputElement>('[name="journalOptIn"]');
    const statStarted = document.querySelector<HTMLElement>('[data-stat-started]');
    const statOpen = document.querySelector<HTMLElement>('[data-stat-open]');
    const statLast = document.querySelector<HTMLElement>('[data-stat-last]');
    const membershipPanel = document.querySelector<HTMLElement>('[data-membership-panel]');
    const membershipSkeleton = document.querySelector<HTMLElement>('[data-membership-skeleton]');
    const membershipContent = document.querySelector<HTMLElement>('[data-membership-content]');
    let annualPriceLabel = formatAnnualPrice(fallbackMarket.amount, fallbackMarket.currency);

    const finishAccountLoading = () => {
      document.querySelectorAll<HTMLElement>('[data-account-email-loading], [data-profile-email-loading], [data-account-action-loading]').forEach((element) => element.classList.add('account-loader-hidden'));
      document.querySelectorAll<HTMLElement>('[data-account-email], [data-profile-email]').forEach((element) => element.classList.remove('hidden'));
      document.querySelectorAll<HTMLAnchorElement>('[data-write-letter]').forEach((link) => link.classList.remove('pointer-events-none', 'opacity-0'));
      membershipSkeleton?.classList.add('account-loader-hidden');
      membershipContent?.classList.remove('hidden');
      membershipPanel?.setAttribute('aria-busy', 'false');
    };

    const startStripeFlow = async (functionName: 'create-checkout' | 'create-portal') => {
      if (!supabase) return;
      if (membershipPrimary) membershipPrimary.setAttribute('aria-busy', 'true');
      setNote(membershipNote, 'Opening the secure payment area…');
      const billingPeriod = localStorage.getItem('one-reader:billing-period') === 'monthly' ? 'monthly' : 'annual';
      const { data, error } = await supabase.functions.invoke(functionName, { body: functionName === 'create-checkout' ? { billingPeriod } : {} });
      if (membershipPrimary) membershipPrimary.removeAttribute('aria-busy');
      if (error || !data?.url) {
        let serverMessage = typeof data?.error === 'string' ? data.error : '';
        const response = (error as { context?: Response } | null)?.context;
        if (!serverMessage && response && typeof response.clone === 'function') {
          const payload = await response.clone().json().catch(() => null) as { error?: unknown } | null;
          if (typeof payload?.error === 'string') serverMessage = payload.error;
        }
        const detail = serverMessage ? ` ${serverMessage}` : error?.message ? ` ${error.message}` : '';
        setNote(membershipNote, `We could not open the secure payment area.${detail || ' Please try again in a moment.'}`, true);
        return;
      }
      if (functionName === 'create-checkout') localStorage.removeItem('one-reader:billing-period');
      window.location.assign(data.url);
    };

    const setNote = (element: HTMLElement | null, message: string, error = false) => {
      if (!element) return;
      element.textContent = message;
      element.classList.remove('hidden', 'text-accent', 'text-destructive');
      element.classList.add(error ? 'text-destructive' : 'text-accent');
    };

    const formatDate = (value: string | null | undefined) => {
      if (!value) return null;
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return null;
      return new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' }).format(date);
    };

    const setBirthDetails = (details: {
      birth_month?: number | null;
      birth_year?: number | null;
      adult_pool_eligible_at?: string | null;
    }) => {
      const saved = Boolean(details.birth_month && details.birth_year && details.adult_pool_eligible_at);
      if (birthMonthInput) {
        birthMonthInput.value = details.birth_month ? String(details.birth_month) : '';
        birthMonthInput.disabled = saved;
        birthMonthInput.required = !saved;
      }
      if (birthYearInput) {
        birthYearInput.value = details.birth_year ? String(details.birth_year) : '';
        birthYearInput.disabled = saved;
        birthYearInput.required = !saved;
      }
      return saved;
    };

    const setWritingReady = (ready: boolean, status: string, canStartOpening: boolean) => {
      const action = status === 'closed'
        ? { href: '#close-account', label: 'Account closed' }
        : status === 'delivery_paused'
          ? { href: '#profile', label: 'Review delivery details' }
          : status === 'waitlisted'
            ? { href: '/', label: 'View your place' }
            : !ready
              ? { href: '#profile', label: 'Complete your profile' }
              : canStartOpening
                ? { href: 'mailto:write@onereader.co?subject=One%20Reader', label: 'Write a letter' }
                : status === 'checkout_pending'
                  ? { href: '#checkout', label: 'Complete payment to become a Writer' }
                  : { href: '#checkout', label: 'Become a Writer to write again' };
      document.querySelectorAll<HTMLAnchorElement>('[data-write-letter]').forEach((link) => {
        link.href = action.href;
        link.textContent = action.label;
      });
      if (!ready && membershipPrimary?.href.startsWith('mailto:')) {
        membershipPrimary.href = '#profile';
        membershipPrimary.textContent = 'Complete your profile';
      }
    };

    const setMembership = (profile: { account_status?: string; plan?: string; founding_season_ends_at?: string | null; subscription_renews_at?: string | null; subscription_current_period_start?: string | null; subscription_current_period_end?: string | null } | null | undefined, startedCount = 0) => {
      membershipRefund?.classList.add('hidden');
      membershipPeriod?.classList.add('hidden');
      membershipCopy?.classList.remove('hidden');
      if (!membershipLabel || !membershipCopy || !membershipPace || !membershipPrimary) return;

      const status = profile?.account_status ?? 'free';
      const seasonEnd = formatDate(profile?.founding_season_ends_at);
      membershipPrimary.classList.remove('hidden');
      membershipPrimary.href = '#checkout';
      membershipPrimary.textContent = 'Become a Writer';

      if (status === 'waitlisted') {
        membershipLabel.textContent = 'Founding waitlist';
        membershipCopy.textContent = seasonEnd ? `You're on the founding waitlist — writing opens when your place comes up. The free founding season ends ${seasonEnd}.` : "You're on the founding waitlist — we'll announce when writing opens.";
        membershipPace.textContent = 'Writing opens with the founding group';
        membershipPrimary.textContent = 'Back to One Reader';
        membershipPrimary.href = '/';
        if (membershipNote) membershipNote.textContent = 'Waitlist members go first and receive the eight-week founding season free, followed by the founding price for their first three paid years.';
      } else if (status === 'founding') {
        membershipLabel.textContent = 'Founding Writer';
        membershipCopy.textContent = seasonEnd ? `Your founding Writer access lets you start a new letter once a day, free, until ${seasonEnd}.` : 'Your founding Writer access lets you start a new letter once a day, free, while the season is open.';
        membershipPace.textContent = 'One new letter every 24 hours';
        membershipPrimary.textContent = 'Write a letter';
        membershipPrimary.href = 'mailto:write@onereader.co?subject=One%20Reader';
        if (membershipNote) membershipNote.textContent = 'After the season, choose Reader or Writer at the founding price for your first three paid years.';
      } else if (status === 'annual') {
        membershipLabel.textContent = 'Writer';
        membershipCopy.textContent = 'You can start one new correspondence every 24 hours. You can also receive letters and reply without limits.';
        membershipPace.textContent = 'One new letter every 24 hours';
        const periodStart = formatDate(profile?.subscription_current_period_start);
        const periodEnd = formatDate(profile?.subscription_current_period_end || profile?.subscription_renews_at);
        if (membershipPeriod && periodStart && periodEnd) {
          membershipPeriod.textContent = `Current membership: ${periodStart} — ${periodEnd}.`;
          membershipPeriod.classList.remove('hidden');
        }
        if (refundType) {
          const startTime = profile?.subscription_current_period_start ? new Date(profile.subscription_current_period_start).getTime() : NaN;
          const ageDays = Number.isFinite(startTime) ? Math.max(0, (Date.now() - startTime) / 86400000) : 0;
          const withdrawal = refundType.querySelector<HTMLOptionElement>('option[value="withdrawal_14_day"]');
          const goodwill = refundType.querySelector<HTMLOptionElement>('option[value="goodwill"]');
          if (withdrawal) withdrawal.hidden = ageDays > 14;
          if (goodwill) goodwill.hidden = ageDays > 30;
          if (refundPolicy) refundPolicy.textContent = ageDays <= 30
            ? 'Requests within 14 days may qualify as statutory withdrawal; One Reader also reviews commercial refund requests within 30 days of activation. Submitting a request does not issue an automatic refund.'
            : 'After 30 days, refund requests are reviewed only for a service problem, failure to provide the service, or an incorrect charge. Submitting a request does not issue an automatic refund.';
        }
        membershipPrimary.textContent = 'Manage Writer';
        membershipPrimary.href = '#billing-portal';
        membershipRefund?.classList.remove('hidden');
        if (membershipNote) membershipNote.textContent = 'Writer can be billed monthly or annually. Manage payment details and cancellation through Stripe; refund requests are reviewed by One Reader.';
      } else if (status === 'checkout_pending') {
        membershipLabel.textContent = 'Reader';
        membershipCopy.textContent = 'Your Writer payment is waiting to be completed. Until then, your Reader access stays active.';
        membershipPace.textContent = 'Complete payment to start a new correspondence every 24 hours';
        membershipPrimary.textContent = 'Complete payment to become a Writer';
        membershipPrimary.href = '#checkout';
        if (membershipNote) membershipNote.textContent = `Complete payment to become a Writer. Annual Writer is ${annualPriceLabel}; monthly billing is also available.`;
      } else if (status === 'closed') {
        membershipLabel.textContent = 'Account closed';
        membershipCopy.textContent = 'Your account is closed and no new letters will be delivered.';
        membershipPace.textContent = 'Service access ended';
        membershipPrimary.textContent = 'Read the privacy notice';
        membershipPrimary.href = '/privacy#rights';
      } else if (status === 'delivery_paused') {
        membershipLabel.textContent = profile?.plan === 'annual' ? 'Writer — delivery paused' : 'Reader — delivery paused';
        membershipCopy.textContent = 'Your account is kept, but new openings are paused until you choose to resume.';
        membershipPace.textContent = 'No new openings while paused';
        membershipPrimary.textContent = 'Review delivery details';
        membershipPrimary.href = '#profile';
      } else {
        membershipLabel.textContent = 'Reader';
        const freeOpeningAvailable = startedCount === 0;
        membershipCopy.textContent = freeOpeningAvailable
          ? 'Your first opening is free. You can always receive letters from strangers and reply to conversations already open.'
          : 'Your free opening has been used. You can still receive letters from strangers and reply to conversations already open.';
        membershipPace.textContent = freeOpeningAvailable ? 'Your free first opening is still available.' : 'Your free first opening has been used.';
        membershipPrimary.textContent = 'Become a Writer to write again';
        membershipPrimary.href = '#checkout';
        membershipPrimary.classList.toggle('hidden', freeOpeningAvailable);
        if (membershipNote) membershipNote.textContent = freeOpeningAvailable
          ? 'Your first opening is ready when you are. Writer becomes available after you use it.'
          : 'Writer lets you start a new correspondence every 24 hours. Choose monthly or annual billing at checkout.';
      }
    };

    membershipPrimary?.addEventListener('click', (event) => {
      const href = membershipPrimary.getAttribute('href');
      if (href !== '#checkout' && href !== '#billing-portal') return;
      event.preventDefault();
      void startStripeFlow(href === '#checkout' ? 'create-checkout' : 'create-portal');
    });

    membershipRefund?.addEventListener('click', (event) => {
      event.preventDefault();
      refundForm?.classList.remove('hidden');
      refundForm?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
    refundCancel?.addEventListener('click', () => refundForm?.classList.add('hidden'));
    refundForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!supabase || !refundType || !refundReason || !refundNote) return;
      refundNote.className = 'mt-4 text-sm leading-6 text-muted-foreground';
      refundNote.textContent = 'Sending your request…';
      const { data, error } = await supabase.functions.invoke('refund-request', { body: { request_type: refundType.value, reason: refundReason.value } });
      if (error || !data?.request_id) {
        refundNote.className = 'mt-4 text-sm leading-6 text-destructive';
        refundNote.textContent = error?.message || 'We could not send the request. Please try again.';
        return;
      }
      refundNote.className = 'mt-4 text-sm leading-6 text-accent';
      refundNote.textContent = 'Your request was received. We will review it and email you with the next step.';
      refundForm.querySelector('button[type="submit"]')?.setAttribute('disabled', 'true');
    });

    document.querySelectorAll<HTMLAnchorElement>('[data-write-letter]').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (link.getAttribute('href') !== '#checkout') return;
        event.preventDefault();
        void startStripeFlow('create-checkout');
      });
    });

    const addLanguageRow = (languageCode = 'en') => {
      if (!languageList || !languageTemplate || languageList.children.length >= 10) return;
      const fragment = languageTemplate.content.cloneNode(true) as DocumentFragment;
      const row = fragment.querySelector<HTMLElement>('[data-language-row]');
      const languageSelect = fragment.querySelector<HTMLSelectElement>('[data-language-select]');
      const removeButton = fragment.querySelector<HTMLButtonElement>('[data-remove-language]');
      if (!row || !languageSelect || !removeButton) return;
      languageSelect.value = languageCode;
      removeButton.addEventListener('click', () => {
        row.remove();
        updateLanguageControls();
      });
      languageList.appendChild(fragment);
      updateLanguageControls();
    };

    const updateLanguageControls = () => {
      if (!languageList || !addLanguageButton) return;
      const rows = Array.from(languageList.querySelectorAll('[data-language-row]'));
      addLanguageButton.classList.toggle('hidden', rows.length >= 10);
      rows.forEach((row) => {
        const remove = row.querySelector<HTMLButtonElement>('[data-remove-language]');
        remove?.classList.toggle('invisible', rows.length === 1);
      });
    };

    const readLanguageRows = () => {
      if (!languageList) return [];
      const seen = new Set<string>();
      return Array.from(languageList.querySelectorAll('[data-language-row]')).flatMap((row, sortOrder) => {
        const languageCode = row.querySelector<HTMLSelectElement>('[data-language-select]')?.value;
        if (!languageCode || seen.has(languageCode)) return [];
        seen.add(languageCode);
        return [{ language_code: languageCode, sort_order: sortOrder }];
      });
    };

    addLanguageButton?.addEventListener('click', () => addLanguageRow());
    addLanguageRow();

    const sessionResult = supabase ? await supabase.auth.getSession() : { data: { session: null } };
    const session = sessionResult.data.session;
    if (!session || !supabase) {
      window.location.assign('/sign-in/');
    } else {
      const client = supabase;
      const email = session.user.email || 'your verified email';
      if (accountEmail) accountEmail.textContent = email;
      if (profileEmail) profileEmail.textContent = email;

      await client.functions.invoke('reconcile-billing');

      const [{ data: profile }, { data: preferences }, { data: savedLanguages }, { data: stats }, { data: journalConsent }, { data: activeDeletionRequest }] = await Promise.all([
        client.from('profiles').select('account_status, plan, founding_season_ends_at, subscription_renews_at, subscription_current_period_start, subscription_current_period_end, birth_month, birth_year, service_eligible_at, adult_pool_eligible_at').eq('id', session.user.id).maybeSingle(),
        client.from('member_preferences').select('country_code, market_currency, language_code, is_available_to_receive').eq('user_id', session.user.id).maybeSingle(),
        client.from('member_languages').select('language_code, sort_order').eq('user_id', session.user.id).order('sort_order', { ascending: true }),
        client.from('member_stats').select('correspondences_started_count, correspondences_open_count, last_letter_sent_at, last_letter_received_at').eq('user_id', session.user.id).maybeSingle(),
        client.from('consent_events').select('granted').eq('user_id', session.user.id).eq('purpose', 'journal_marketing').order('created_at', { ascending: false }).limit(1).maybeSingle(),
        client.from('privacy_requests').select('id, status, created_at').eq('user_id', session.user.id).eq('request_type', 'deletion').in('status', ['requested', 'in_progress']).order('created_at', { ascending: false }).limit(1).maybeSingle(),
      ]);

      let birthDetailsSaved = setBirthDetails(profile ?? {});
      const canStartOpening = profile?.account_status === 'annual'
        || profile?.account_status === 'founding'
        || (profile?.account_status === 'free' && (stats?.correspondences_started_count ?? 0) === 0);
      const marketCountry = preferences?.country_code || navigator.language.split('-')[1] || '';
      const market = marketForCountry(marketCountry);
      annualPriceLabel = formatAnnualPrice(market.amount, market.currency, navigator.language || 'en');
      setMembership(profile, stats?.correspondences_started_count ?? 0);
      setWritingReady(birthDetailsSaved, profile?.account_status ?? 'free', canStartOpening);
      if (languageList && savedLanguages?.length) {
        languageList.innerHTML = '';
        savedLanguages.forEach((language) => addLanguageRow(language.language_code));
      } else if (languageList && preferences?.language_code) {
        languageList.innerHTML = '';
        addLanguageRow(preferences.language_code);
      }
      if (journalCheckbox && typeof journalConsent?.granted === 'boolean') journalCheckbox.checked = journalConsent.granted;
      if (statStarted) statStarted.textContent = String(stats?.correspondences_started_count ?? 0);
      if (statOpen) statOpen.textContent = String(stats?.correspondences_open_count ?? 0);
      const lastActivity = [stats?.last_letter_sent_at, stats?.last_letter_received_at].filter(Boolean).sort().at(-1);
      if (statLast) statLast.textContent = formatDate(lastActivity) ?? 'None yet';
      let deletionRequestRecorded = Boolean(activeDeletionRequest);
      if (deletionRequestRecorded) {
        if (deleteButton) {
          deleteButton.disabled = true;
          deleteButton.textContent = 'Deletion request recorded';
        }
        setNote(deleteNote, 'Your account is closed and new deliveries are stopped. We will retain only the minimum records needed for up to 30 days, then remove them unless a longer legal obligation applies.');
        void client.functions.invoke('privacy-request', { body: { request_type: 'deletion' } });
      }

      finishAccountLoading();

      profileForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const languagesToSave = readLanguageRows();
        if (!languagesToSave.length) {
          setNote(profileNote, 'Add at least one language before saving.', true);
          return;
        }
        if (!birthDetailsSaved) {
          const birthMonth = Number(birthMonthInput?.value);
          const birthYear = Number(birthYearInput?.value);
          if (!Number.isInteger(birthMonth) || !Number.isInteger(birthYear)) {
            setNote(profileNote, 'Choose your birth month and enter your birth year.', true);
            return;
          }
          const serviceEligibleAt = new Date(Date.UTC(birthYear + 14, birthMonth, 1));
          if (serviceEligibleAt.getTime() > Date.now()) {
            setNote(profileNote, 'One Reader is available from age 14. Your account cannot enter a matching pool yet.', true);
            return;
          }
          const { data: birthResult, error: birthError } = await client.functions.invoke('set-birth-details', {
            body: { birthMonth, birthYear },
          });
          if (birthError) {
            setNote(profileNote, 'We could not save your birth details. Please check them and try again.', true);
            return;
          }
          birthDetailsSaved = setBirthDetails({
            birth_month: birthMonth,
            birth_year: birthYear,
            adult_pool_eligible_at: birthResult?.adultPoolEligibleAt,
          });
          setMembership(profile, stats?.correspondences_started_count ?? 0);
          setWritingReady(birthDetailsSaved, profile?.account_status ?? 'free', canStartOpening);
        }
        const { data: existingLanguages } = await client.from('member_languages').select('language_code').eq('user_id', session.user.id);
        const selectedCodes = new Set(languagesToSave.map((language) => language.language_code));
        for (const existing of existingLanguages ?? []) {
          if (!selectedCodes.has(existing.language_code)) {
            await client.from('member_languages').delete().eq('user_id', session.user.id).eq('language_code', existing.language_code);
          }
        }
        const { error: languageError } = await client.from('member_languages').upsert(languagesToSave.map((language) => ({ ...language, user_id: session.user.id, updated_at: new Date().toISOString() })), { onConflict: 'user_id,language_code' });
        const { error: preferenceError } = await client.from('member_preferences').upsert({
          user_id: session.user.id,
          country_code: preferences?.country_code ?? null,
          market_currency: preferences?.market_currency ?? null,
          language_code: languagesToSave[0].language_code,
          is_available_to_receive: true,
          updated_at: new Date().toISOString(),
        }, { onConflict: 'user_id' });
        const error = languageError || preferenceError;
        setNote(profileNote, error ? 'We could not save those details. Please try again.' : 'Your details are saved.', Boolean(error));
      });

      consentForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!journalCheckbox) return;
        const { error } = await client.from('consent_events').insert({
          user_id: session.user.id,
          purpose: 'journal_marketing',
          granted: journalCheckbox.checked,
          policy_version: '2026-08-09',
          consent_text: 'Optional Journal notes and product news.',
          source: 'account',
        });
        setNote(consentNote, error ? 'We could not save that choice. Please try again.' : 'Your communication choice is saved.', Boolean(error));
      });

      document.querySelectorAll<HTMLButtonElement>('[data-privacy-request]').forEach((button) => {
        button.addEventListener('click', async () => {
          const requestType = button.dataset.privacyRequest === 'rectification' ? 'rectification' : 'access';
          button.disabled = true;
          const { error } = await client.functions.invoke('privacy-request', { body: { request_type: requestType } });
          if (error) button.disabled = false;
          const success = requestType === 'rectification'
            ? 'Your correction request is recorded. We will follow up by email before making any change.'
            : 'Your access request is recorded. We will follow up by email.';
          setNote(privacyNote, error ? 'We could not record the request. Please try again.' : success, Boolean(error));
        });
      });

      deleteForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (deletionRequestRecorded) return;
        if (!window.confirm('Request permanent deletion of your One Reader account?')) return;
        if (deleteButton) deleteButton.disabled = true;
        const { data, error } = await client.functions.invoke('privacy-request', { body: { request_type: 'deletion' } });
        if (error) {
          if (deleteButton) deleteButton.disabled = false;
          setNote(deleteNote, 'We could not record the deletion request. Please try again.', true);
          return;
        }
        deletionRequestRecorded = true;
        if (deleteButton) {
          deleteButton.textContent = 'Deletion request recorded';
        }
        setNote(deleteNote, data?.already_recorded
          ? 'Your account is closed and new deliveries are stopped. We will retain only the minimum records needed for up to 30 days, then remove them unless a longer legal obligation applies.'
          : 'Your account is now closed and new deliveries are stopped. We will retain only the minimum records needed for up to 30 days, then remove them unless a longer legal obligation applies.');
      });
    }

    document.querySelector<HTMLButtonElement>('[data-sign-out]')?.addEventListener('click', async () => {
      if (supabase) await supabase.auth.signOut();
      window.location.assign('/');
    });
  </script>
</Layout>
