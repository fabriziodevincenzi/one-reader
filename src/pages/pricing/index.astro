---
import Layout from '../../layouts/Layout.astro';
import { buttonVariants } from '../../components/ui/Button';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { priceGrid } from '../../lib/product-config';
import { currencyByCountry } from '../../lib/market-pricing';
---
<Layout title="Pricing — One Reader" description="Reader is free. Writer lets you start a new conversation every day.">
  <SiteHeader />
  <main class="pricing-page">
    <header class="border-b border-border px-7 py-16 text-center sm:py-20"><p class="eyebrow mb-5">Pricing</p><h1 class="pricing-title mx-auto">One letter costs nothing.<br />Writing more, only a little.</h1><p class="pricing-deck mx-auto mt-5">Start by writing to a stranger for free. If you find yourself wanting to write again, Writer is there — a couple of euros a month, cancel whenever.</p><div class="mt-9 inline-flex rounded-full border border-foreground p-1 text-sm"><button class="rounded-full bg-foreground px-5 py-2 text-background" type="button" data-billing="monthly">Monthly</button><button class="rounded-full px-5 py-2 text-muted-foreground" type="button" data-billing="annual">Annual</button></div><p class="mt-3 min-h-5 text-xs text-accent" data-billing-note></p></header>
    <section class="grid gap-7 px-7 py-14 md:grid-cols-2"><article class="rounded border border-border p-8"><p class="metadata">Reader</p><p class="mt-2 font-serif italic text-muted-foreground">To find out if this is for you</p><p class="mt-8 font-mono text-4xl">€0</p><p class="mt-2 text-sm text-muted-foreground">Free, always</p><a class={buttonVariants({ size: 'large' }) + ' mt-8 w-full'} href="/#start-free">Start free</a><ul class="pricing-features"><li>Write one letter, to start one conversation</li><li>Reply to every letter you receive, without limit</li><li>A new alias for each conversation</li><li>Conversations close after 30 days of silence</li></ul></article><article class="writer-card rounded border border-foreground p-8"><p class="metadata">Writer</p><p class="mt-2 font-serif italic text-muted-foreground">To keep writing first</p><p class="mt-8 font-mono text-4xl"><span data-writer-price>€2</span> <span class="text-sm text-muted-foreground" data-writer-period>/ month</span></p><p class="mt-2 min-h-5 text-sm text-muted-foreground" data-writer-sub></p><a class={buttonVariants({ variant: 'outline', size: 'large' }) + ' mt-8 w-full'} href="/sign-in/" data-writer-cta>Choose Writer</a><ul class="pricing-features"><li>Start one new conversation every day</li><li>Everything included in Reader</li><li>Switch monthly or annual at your next renewal</li><li>Cancel whenever — no questions asked</li></ul></article></section>
    <section class="border-t border-border px-7 py-14"><h2 class="metadata text-center">What actually changes</h2><div class="mt-7 overflow-x-auto"><table><thead><tr><th></th><th>Reader — free</th><th>Writer — paid</th></tr></thead><tbody><tr><td>Starting a conversation</td><td>Once, ever</td><td>Once a day</td></tr><tr><td>Replying to letters</td><td>Unlimited</td><td>Unlimited</td></tr><tr><td>Your name in each letter</td><td>A new alias per conversation</td><td>A new alias per conversation</td></tr><tr><td>When a conversation ends</td><td>After 30 days of silence, or either side ending it</td><td>After 30 days of silence, or either side ending it</td></tr></tbody></table></div></section>
    <section class="border-t border-border px-7 py-10"><div class="mx-auto max-w-2xl divide-y divide-border"><details open><summary>Why would I pay for this?</summary><p>Reader lets you write once and reply as often as people write to you. Writer is for when you want to be the one who starts things — more than once.</p></details><details><summary>Can I switch between monthly and annual?</summary><p>Yes, from your account. The new plan takes effect at your next renewal — no partial charges, no mid-cycle math.</p></details><details><summary>What happens if I cancel Writer?</summary><p>You move back to Reader. Conversations already open stay open, and you can still reply for as long as they last.</p></details></div></section>
  </main>
  <SiteFooter />
</Layout>
<script define:vars={{ priceGrid, currencyByCountry }}>
  const requestedCurrency = currencyByCountry[(navigator.language.split('-')[1] || '').toUpperCase()];
  const currency = requestedCurrency && priceGrid[requestedCurrency] ? requestedCurrency : 'EUR';
  const market = { currency };
  const prices = priceGrid;
  const billingStorageKey = 'one-reader:billing-period';
  const format = (amount) => new Intl.NumberFormat(navigator.language || 'en', { style: 'currency', currency: market.currency, minimumFractionDigits: 0, maximumFractionDigits: 2 }).format(amount);
  const plans = { monthly: { price: format(prices[market.currency].monthly), period: '/ month', sub: '', note: '' }, annual: { price: format(prices[market.currency].full), period: '/ year', sub: `Works out to ${format(prices[market.currency].full / 12)} / month`, note: 'Save about 25% vs. paying monthly' } };
  const applyPlan = (planKey, persist = true) => { const plan = plans[planKey]; if (persist) localStorage.setItem(billingStorageKey, planKey); document.querySelectorAll('[data-billing]').forEach((item) => item.className = 'rounded-full px-5 py-2 text-muted-foreground'); document.querySelector(`[data-billing="${planKey}"]`)?.classList.add('bg-foreground', 'text-background'); document.querySelector('[data-writer-price]').textContent = plan.price; document.querySelector('[data-writer-period]').textContent = plan.period; document.querySelector('[data-writer-sub]').textContent = plan.sub; document.querySelector('[data-billing-note]').textContent = plan.note; };
  document.querySelectorAll('[data-billing]').forEach((button) => button.addEventListener('click', () => applyPlan(button.dataset.billing)));
  applyPlan('monthly', false);
</script>
<style>
.pricing-page{max-width:1040px;margin:auto}.pricing-title{font:400 clamp(2rem,4vw,2.625rem)/1.2 var(--font-interface);letter-spacing:-.01em}.pricing-deck{max-width:32rem;font:400 1.06rem/1.6 var(--font-letter);color:var(--muted-foreground)}.pricing-features{margin:1.8rem 0 0;padding:0;list-style:none;font:400 .95rem/1.5 var(--font-letter)}.pricing-features li{border-top:1px solid var(--border);padding:.75rem 0}.pricing-features li:before{content:'+';color:var(--accent);font-family:var(--font-interface);margin-right:.65rem}table{width:100%;border-collapse:collapse;font:400 .9rem/1.5 var(--font-letter)}th,td{padding:1rem .75rem;border-bottom:1px solid var(--border);text-align:left;vertical-align:top}th{font:400 .72rem/1.4 var(--font-interface);text-transform:uppercase;color:var(--muted-foreground)}td:first-child{color:var(--muted-foreground)}details{padding:1.3rem 0}summary{cursor:pointer;font:400 .9rem/1.5 var(--font-interface)}details p{max-width:38rem;margin:.6rem 0 0;font:400 .95rem/1.6 var(--font-letter);color:var(--muted-foreground)}
<style>
  .pricing-page { width: min(100% - 3.5rem, 720px); max-width: none; margin-inline: auto; }
</style>
