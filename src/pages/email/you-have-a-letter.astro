---
import Layout from '../../layouts/Layout.astro';
import { buttonVariants } from '../../components/ui/Button';
---

<Layout title="You have a letter — One Reader" description="A preview of the One Reader letter notification email." indexable={false}>
  <main id="main-content" class="min-h-[85vh] bg-surface px-5 py-12 sm:px-8 sm:py-20">
    <div class="mx-auto max-w-[35rem]">
      <p class="eyebrow mb-5 text-center">Email preview · no tracking pixels</p>
      <article class="bg-surface py-6">
        <header class="flex items-center justify-between pb-10">
          <p class="brand-logo m-0">One Reader</p>
          <p class="eyebrow m-0 text-[0.65rem]">A letter for you</p>
        </header>
        <div>
          <p class="m-0 font-serif text-lg leading-8 text-foreground/90">This morning the rain stopped just before I left home. For a few minutes, every window on my street held the same pale light…</p>
        </div>
        <footer class="pt-10">
          <p class="m-0 text-xs leading-5 text-muted-foreground">You can reply directly to this email. Your real address stays hidden unless you both choose to continue outside One Reader.</p>
          <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a class={buttonVariants({ variant: 'quiet', size: 'small' })} href="/email/action/stop/">End this correspondence</a>
            <a class={buttonVariants({ variant: 'quiet', size: 'small' })} href="/email/action/report/">Report this letter</a>
          </div>
        </footer>
      </article>
      <p class="mt-6 text-center text-xs text-muted-foreground">This is a design preview. In production, the letter arrives in your normal inbox.</p>
    </div>
  </main>
</Layout>
