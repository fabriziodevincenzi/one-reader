---
import Layout from '../../layouts/Layout.astro';
import { Button } from '../../components/ui/Button';
import { Input } from '../../components/ui/Input';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Layout title="Sign in — One Reader" description="Sign in to your private One Reader account with a one-time email link." turnstileSiteKey={turnstileSiteKey} indexable={false}>
  <SiteHeader />

  <main class="shell brand-page min-h-[82vh] max-w-xl py-20 sm:py-28 lg:py-36">
    <div class="mx-auto max-w-lg">
      <p class="eyebrow mb-6" data-auth-eyebrow>Sign in</p>
      <h1 class="section-title balance" data-auth-heading>Welcome back.</h1>
      <p class="mt-8 text-lg leading-8 text-muted-foreground" data-auth-intro>Enter your email and we’ll send a one-time sign-in link. There is no password to remember.</p>

      <form class="mt-12" data-magic-link-form>
        <div data-sign-in-fields>
          <label class="mb-2 block text-sm font-medium" for="sign-in-email">Email address</label>
          <div class="grid gap-3 sm:grid-cols-[1fr_auto]">
            <Input id="sign-in-email" name="email" type="email" autoComplete="email" placeholder="you@example.com" required />
            <Button type="submit" size="large" data-submit-label>Send sign-in link</Button>
          </div>
        </div>
        <p class="mt-4 text-xs leading-5 text-muted-foreground" data-flow-helper>
          The link is single-use and expires shortly.
        </p>
        {turnstileSiteKey && (
          <div class="mt-6 hidden rounded-sm bg-muted/40 p-5" data-sign-in-captcha-step>
            <label class="flex items-start gap-3 text-sm leading-6" data-sign-in-human-confirmation>
              <input class="mt-1" type="checkbox" data-sign-in-human-checkbox />
              <span>I’m human. Continue with the Cloudflare security check.</span>
            </label>
            <div class="mt-5 hidden" data-sign-in-turnstile-panel>
              <div class="w-full max-w-full" data-sign-in-turnstile data-sitekey={turnstileSiteKey} aria-label="Cloudflare security check"></div>
            </div>
          </div>
        )}
        <p class="mt-5 hidden text-sm leading-6 text-accent" data-magic-link-note aria-live="polite"></p>
      </form>
      <p class="mt-8 text-[0.75rem] leading-5 text-muted-foreground" data-sign-up-link>New to One Reader? <a class="text-foreground underline underline-offset-4" href="/#start-free">Create a free account</a></p>
      <p class="mt-8 hidden text-sm" data-change-email-back><a class="underline underline-offset-4" href="/member/#profile">Return to your account</a></p>
    </div>
  </main>
  <SiteFooter />
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  const isChangeEmail = new URLSearchParams(window.location.search).get('mode') === 'change-email';
  const form = document.querySelector<HTMLFormElement>('[data-magic-link-form]')!;
  const fields = document.querySelector<HTMLElement>('[data-sign-in-fields]');
  const flowHelper = document.querySelector<HTMLElement>('[data-flow-helper]');
  const eyebrow = document.querySelector<HTMLElement>('[data-auth-eyebrow]');
  const heading = document.querySelector<HTMLElement>('[data-auth-heading]');
  const intro = document.querySelector<HTMLElement>('[data-auth-intro]');
  const submitLabel = document.querySelector<HTMLElement>('[data-submit-label]');
  const changeEmailBack = document.querySelector<HTMLElement>('[data-change-email-back]');
  const captchaStep = document.querySelector<HTMLElement>('[data-sign-in-captcha-step]');
  const captchaWidget = document.querySelector<HTMLElement>('[data-sign-in-turnstile]');
  const humanCheckbox = document.querySelector<HTMLInputElement>('[data-sign-in-human-checkbox]');
  const turnstilePanel = document.querySelector<HTMLElement>('[data-sign-in-turnstile-panel]');
  const note = document.querySelector<HTMLElement>('[data-magic-link-note]');
  const signUpLink = document.querySelector<HTMLElement>('[data-sign-up-link]');
  type TurnstileApi = {
    render: (element: HTMLElement, options: Record<string, unknown>) => string;
    reset: (widgetId: string) => void;
  };
  let captchaWidgetId: string | null = null;
  let captchaToken: string | null = null;
  let pendingEmail: string | null = null;
  let signInRequestInFlight = false;
  const signInRequestKey = 'one-reader:last-sign-in-link-request';
  const signInRequestCooldownMs = 60_000;

  if (isChangeEmail) {
    document.title = 'Change email — One Reader';
    eyebrow!.textContent = 'Account security';
    heading!.textContent = 'Change your email address.';
    intro!.textContent = 'Enter the new address for your One Reader account. Your current address remains active until you confirm the change from the new inbox.';
    submitLabel!.textContent = 'Send confirmation';
    flowHelper!.textContent = 'For your security, this page only works while you are signed in.';
    changeEmailBack?.classList.remove('hidden');
    signUpLink?.classList.add('hidden');
  }
  const showNote = (message: string, error = false) => {
    if (!note) return;
    note.textContent = message;
    note.classList.remove('hidden', 'text-accent', 'text-destructive');
    note.classList.add(error ? 'text-destructive' : 'text-accent');
  };

  const showLeadNote = () => {
    if (!note) return;
    note.textContent = 'There is no account attached to this address yet. ';
    const link = document.createElement('a');
    link.href = '/#start-free';
    link.textContent = 'Start free from the home page';
    link.className = 'underline underline-offset-4';
    note.append(link);
    note.classList.remove('hidden', 'text-accent', 'text-destructive');
    note.classList.add('text-accent');
  };

  const showExpiredSessionNote = () => {
    if (!note) return;
    note.textContent = 'Your session has expired. ';
    const link = document.createElement('a');
    link.href = '/sign-in/';
    link.textContent = 'Sign in again before changing your email';
    link.className = 'underline underline-offset-4';
    note.append(link);
    note.classList.remove('hidden', 'text-accent', 'text-destructive');
    note.classList.add('text-destructive');
  };

  const resetCaptcha = () => {
    captchaToken = null;
    const turnstile = (window as Window & { turnstile?: TurnstileApi }).turnstile;
    if (turnstile && captchaWidgetId) turnstile.reset(captchaWidgetId);
  };

  const restoreFields = () => {
    fields?.classList.remove('hidden');
    flowHelper?.classList.remove('hidden');
    captchaStep?.classList.add('hidden');
    if (humanCheckbox) {
      humanCheckbox.checked = false;
      humanCheckbox.disabled = false;
    }
    turnstilePanel?.classList.add('hidden');
    pendingEmail = null;
  };

  const showSuccessState = (message: string) => {
    fields?.classList.add('hidden');
    flowHelper?.classList.add('hidden');
    captchaStep?.classList.add('hidden');
    showNote(message);
  };

  const hasRecentSignInRequest = () => {
    const lastRequestedAt = Number(window.localStorage.getItem(signInRequestKey) || '0');
    return Date.now() - lastRequestedAt < signInRequestCooldownMs;
  };

  const sendSignInLink = async () => {
    if (!pendingEmail || !supabase || signInRequestInFlight) return;
    if (hasRecentSignInRequest()) {
      resetCaptcha();
      showSuccessState('A sign-in link was just requested. Please use the most recent email, or wait a minute before requesting another.');
      return;
    }

    signInRequestInFlight = true;
    const email = pendingEmail;
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submitButton) submitButton.disabled = true;
    showNote('Sending your sign-in link…');
    window.localStorage.setItem(signInRequestKey, String(Date.now()));

    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: {
        shouldCreateUser: false,
        emailRedirectTo: `${window.location.origin}/sign-in/`,
        captchaToken: captchaToken ?? undefined,
      },
    });
    signInRequestInFlight = false;
    if (submitButton) submitButton.disabled = false;
    if (error) {
      window.localStorage.removeItem(signInRequestKey);
      const isUnknownAccount = /signups? not allowed|user not found|no user|user_not_found/i.test(error.message);
      if (isUnknownAccount) {
        const { error: leadError } = await supabase.from('leads').insert({ email_address: email, source: 'sign_in' });
        resetCaptcha();
        restoreFields();
        if (leadError) {
          showNote('We could not complete the request. Please try again in a moment.', true);
          return;
        }
        showLeadNote();
        return;
      }
      resetCaptcha();
      restoreFields();
      showNote('We could not send a sign-in link. Please try again in a moment.', true);
      return;
    }
    resetCaptcha();
    showSuccessState('Your sign-in link is on its way. Check your inbox — it is single-use and will open your private area.');
  };

  const renderCaptcha = () => {
    const turnstile = (window as Window & { turnstile?: TurnstileApi }).turnstile;
    const sitekey = captchaWidget?.dataset.sitekey;
    if (!turnstile || !captchaWidget || !sitekey || captchaWidget.dataset.rendered) return;
    captchaWidgetId = turnstile.render(captchaWidget, {
      sitekey,
      theme: 'light',
      size: 'flexible',
      appearance: 'always',
      language: 'en',
      callback: (token: string) => {
        captchaToken = token;
        void sendSignInLink();
      },
      'expired-callback': resetCaptcha,
      'error-callback': () => {
        resetCaptcha();
        restoreFields();
        showNote('The security check could not be completed. Please try again.', true);
      },
    });
    captchaWidget.dataset.rendered = 'true';
  };

  humanCheckbox?.addEventListener('change', () => {
    if (!humanCheckbox.checked) return;
    humanCheckbox.disabled = true;
    turnstilePanel?.classList.remove('hidden');
    window.setTimeout(renderCaptcha, 0);
  });

  const verifyChangeEmailSession = async () => {
    if (!isChangeEmail || !supabase) return;
    const { data, error } = await supabase.auth.getSession();
    if (error || !data.session) {
      fields?.classList.add('hidden');
      flowHelper?.classList.add('hidden');
      showExpiredSessionNote();
    }
  };

  void verifyChangeEmailSession();

  supabase?.auth.onAuthStateChange((event, session) => {
    const hasCallbackToken = window.location.hash.includes('access_token');
    if (session && (event === 'SIGNED_IN' || (event === 'INITIAL_SESSION' && hasCallbackToken))) {
      if (hasCallbackToken) window.history.replaceState({}, document.title, '/sign-in/');
      if (!isChangeEmail) window.location.assign('/member/');
    }
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const email = String(new FormData(form).get('email') || '').trim().toLowerCase();
    if (!email || !supabase) {
      if (!supabase) showNote('Supabase is not configured in this environment.', true);
      return;
    }

    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submitButton) submitButton.disabled = true;
    showNote(isChangeEmail ? 'Sending the confirmation…' : 'Complete the security check to continue.');

    if (isChangeEmail) {
      const { data } = await supabase.auth.getSession();
      if (!data.session) {
        if (submitButton) submitButton.disabled = false;
        showNote('Sign in before changing the email address.', true);
        return;
      }
      const { error } = await supabase.auth.updateUser({ email });
      if (submitButton) submitButton.disabled = false;
      if (error) {
        showNote(error.message || 'We could not start the email change. Please try again.', true);
        return;
      }
      form.reset();
      showNote('Check the new address to confirm the change.');
      return;
    }
    if (!captchaWidget || !captchaStep) {
      if (submitButton) submitButton.disabled = false;
      showNote('The security check is not available. Please try again later.', true);
      return;
    }
    if (hasRecentSignInRequest()) {
      if (submitButton) submitButton.disabled = false;
      showNote('A sign-in link was just requested. Please use the most recent email, or wait a minute before requesting another.');
      return;
    }
    pendingEmail = email;
    fields?.classList.add('hidden');
    flowHelper?.classList.add('hidden');
    if (humanCheckbox) {
      humanCheckbox.checked = false;
      humanCheckbox.disabled = false;
    }
    turnstilePanel?.classList.add('hidden');
    captchaStep?.classList.remove('hidden');
  });
</script>
